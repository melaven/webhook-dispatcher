# ============== REPLAY ATTACK PROTECTION ==============

# 🛡️ Защита от replay-атак (повторного воспроизведения перехваченных запросов)
REPLAY_PROTECTION_ENABLED=true

# Максимальный возраст timestamp в секундах (по умолчанию 300 = 5 минут)
# Запросы старше этого времени будут отклонены
MAX_TIMESTAMP_AGE_SECONDS=300

# Размер кеша для хранения использованных nonce (по умолчанию 10000)
# Увеличьте если ожидаете большой объем запросов
NONCE_CACHE_SIZE=10000

# Интервал очистки устаревших nonce в секундах (по умолчанию 3600 = 1 час)
NONCE_CLEANUP_INTERVAL=3600

# ============== SECURITY CONFIGURATION ==============

# API Key для аутентификации входящих вебхуков
# В production: используйте криптостойкий ключ длиной не менее 32 символов
# Генерация: openssl rand -hex 32 или python -c "import secrets; print(secrets.token_hex(32))"
DISPATCHER_API_KEY=your_secure_api_key_here_32_chars_minimum

# HMAC Secret для проверки подписей вебхуков (опционально)
# Используется для верификации что данные не были подделаны
# Генерация: openssl rand -hex 64
WEBHOOK_SECRET=your_hmac_secret_key_here_64_chars_recommended

# ============== DATABASE CONFIGURATION ==============

# SQLite база данных создается автоматически в ./data/webhook_audit.db
# Дополнительные настройки БД (если потребуются в будущем)
DATABASE_URL=sqlite+aiosqlite:///./data/webhook_audit.db
DATABASE_ECHO=false

# ============== APPLICATION CONFIGURATION ==============

# Режим работы приложения
ENVIRONMENT=production
DEBUG=false

# Настройки логирования
LOG_LEVEL=INFO
LOG_FORMAT=json

# Настройки сервера
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Таймауты (в секундах)
REQUEST_TIMEOUT=30
SHUTDOWN_TIMEOUT=60

# ============== CORS CONFIGURATION ==============

# Разрешенные домены для CORS (через запятую)
# В production: укажите только нужные домены
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
ALLOWED_METHODS=GET,POST
ALLOWED_HEADERS=*

# ============== RATE LIMITING ==============

# Лимиты запросов (если будет реализовано)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============== EXTERNAL INTEGRATIONS ==============

# CRM Integration (если будет реализовано)
CRM_API_URL=https://your-crm-api.com/webhooks
CRM_API_KEY=your_crm_api_key_here

# Email Service (если будет реализовано)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@yourdomain.com

# Slack Integration (если будет реализовано)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#webhooks-alerts

# ============== MONITORING & OBSERVABILITY ==============

# Sentry для отслеживания ошибок (если будет реализовано)
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# Prometheus метрики
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Health Check настройки
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# ============== SECURITY HEADERS ==============

# Content Security Policy
CSP_HEADER=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'

# HTTPS принуждение (для production за reverse proxy)
FORCE_HTTPS=true
SECURE_COOKIES=true

# ============== BACKUP CONFIGURATION ==============

# Автоматическое резервное копирование БД (если будет реализовано)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=webhook-dispatcher/

# ============== DEVELOPMENT SETTINGS ==============

# Используйте эти настройки только в development окружении!
# В production все должно быть false/закомментировано

# DEV_MODE=true
# DEV_AUTO_RELOAD=true
# DEV_SHOW_DOCS=true
# DEV_CORS_ALLOW_ALL=true

# ============== DOCKER & DEPLOYMENT ==============

# Docker specific environment variables
PYTHONPATH=/app
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Kubernetes/Cloud specific (если будет использоваться)
K8S_NAMESPACE=webhook-dispatcher
K8S_SERVICE_NAME=webhook-dispatcher-service
CLOUD_REGION=us-east-1

# ============== ВАЖНЫЕ ИНСТРУКЦИИ ==============

# 1. НИКОГДА НЕ КОММИТЬТЕ .env файл с реальными ключами в Git!
# 2. Скопируйте этот файл в .env и заполните реальными значениями
# 3. Используйте менеджер секретов (AWS Secrets Manager, HashiCorp Vault) в production
# 4. Регулярно ротируйте API ключи и секреты
# 5. Используйте разные ключи для development/staging/production окружений

# Команды для генерации безопасных ключей:
# API Key: python -c "import secrets; print('DISPATCHER_API_KEY=' + secrets.token_hex(32))"
# HMAC Secret: python -c "import secrets; print('WEBHOOK_SECRET=' + secrets.token_hex(64))"
# Or: openssl rand -hex 32